{
  "includeCoAuthoredBy": false,
  "model": "fable",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true
